* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.pro text eol=lf
*.properties text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary archives and media (prevent CRLF corruption)
*.jar binary
*.apk binary
*.png binary
*.webp binary
*.jpg binary
*.ico binary
